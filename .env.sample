PORT=8000

# Privileged connection — migrations, seeding, trusted metadata reads.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sqlruleengine

# Least-privilege, read-only role used ONLY to run untrusted user SQL.
# Provision it with: pnpm run db:sandbox (after seeding).
SANDBOX_DATABASE_URL=postgresql://sandbox_ro:sandbox_ro@postgres:5432/sqlruleengine

REDIS_URL=redis://redis:6379

# Sandbox execution guardrails (all applied per-query in a read-only transaction).
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_LOCK_TIMEOUT_MS=3000
SQL_IDLE_IN_TX_TIMEOUT_MS=10000
SQL_MAX_ROWS=10000
